# systemd user service for Linux.
#   mkdir -p ~/.config/systemd/user && cp scripts/autocontent.service ~/.config/systemd/user/
#   adjust the paths below, then:  systemctl --user enable --now autocontent
#   keep it running without an active login:  loginctl enable-linger "$USER"
[Unit]
Description=AutoContent AI local server
After=network-online.target

[Service]
WorkingDirectory=%h/autocontent-ai/backend
ExecStart=%h/autocontent-ai/backend/.venv/bin/python -m app
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=40

[Install]
WantedBy=default.target
