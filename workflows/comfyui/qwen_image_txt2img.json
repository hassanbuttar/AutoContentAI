{
  "name": "Qwen-Image 2512 — vertical scene (txt2img)",
  "description": "Text-to-image scene generator using the locally installed Qwen-Image 2512 fp8 model. 928x1664 (9:16), upscaled to 1080x1920 by FFmpeg.",
  "kind": "txt2img",
  "output_type": "image",
  "is_default": true,
  "timeout_seconds": 600,
  "defaults": {
    "width": 928,
    "height": 1664,
    "steps": 24,
    "negative_prompt": "text, watermark, logo, signature, blurry, low quality, deformed, extra fingers, jpeg artifacts"
  },
  "mappings": {
    "positive_prompt": {"node": "5", "input": "text"},
    "negative_prompt": {"node": "6", "input": "text"},
    "seed": {"node": "8", "input": "seed"},
    "width": {"node": "7", "input": "width"},
    "height": {"node": "7", "input": "height"},
    "steps": {"node": "8", "input": "steps"},
    "filename_prefix": {"node": "10", "input": "filename_prefix"}
  },
  "workflow": {
    "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "qwen_image_2512_fp8_e4m3fn.safetensors", "weight_dtype": "default"}},
    "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image"}},
    "3": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
    "4": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["1", 0], "shift": 3.1}},
    "5": {"class_type": "CLIPTextEncode", "inputs": {"text": "a modern software dashboard on a laptop, cinematic lighting", "clip": ["2", 0]}},
    "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "text, watermark, blurry", "clip": ["2", 0]}},
    "7": {"class_type": "EmptySD3LatentImage", "inputs": {"width": 928, "height": 1664, "batch_size": 1}},
    "8": {"class_type": "KSampler", "inputs": {"model": ["4", 0], "seed": 42, "steps": 24, "cfg": 3.0, "sampler_name": "euler",
                                               "scheduler": "simple", "positive": ["5", 0], "negative": ["6", 0],
                                               "latent_image": ["7", 0], "denoise": 1.0}},
    "9": {"class_type": "VAEDecode", "inputs": {"samples": ["8", 0], "vae": ["3", 0]}},
    "10": {"class_type": "SaveImage", "inputs": {"images": ["9", 0], "filename_prefix": "autocontent/scene"}}
  }
}
