# AutoContent AI configuration (copy to .env). Runtime settings (budgets, ComfyUI URL, video,
# schedules...) are edited in the dashboard; only bootstrap values belong here.

AUTOCONTENT_HOST=127.0.0.1
AUTOCONTENT_PORT=8000
# AUTOCONTENT_STORAGE_DIR=D:\AutoContent\storage
# AUTOCONTENT_DATABASE_URL=postgresql+psycopg://user:pass@localhost/autocontent   # optional; default SQLite in storage/

# Secrets master key. Default: generated and kept in the OS keychain (Windows Credential Manager /
# Secret Service). Set this only on headless machines without a keychain (Docker, servers).
# AUTOCONTENT_MASTER_KEY=

# Mode B (remote dashboard through an HTTPS tunnel such as Cloudflare Tunnel / Tailscale):
# AUTOCONTENT_PUBLIC_BASE_URL=https://autocontent.example.com
# AUTOCONTENT_COOKIE_SECURE=true
# AUTOCONTENT_CORS_ORIGINS=["https://dashboard.example.com"]   # only if the dashboard is served from another origin

# Split roles (run `python -m app.worker` separately):
# AUTOCONTENT_RUN_WORKERS=false
# AUTOCONTENT_RUN_SCHEDULER=false
# AUTOCONTENT_GPU_LANE_CONCURRENCY=1
# AUTOCONTENT_DEFAULT_LANE_CONCURRENCY=2
